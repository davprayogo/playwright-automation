{
  "name": "playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "E2E automation testing: sanity, CRUD regression, dan seeding master data",
  "scripts": {
    "test": "playwright test",
    "test:sanity": "playwright test --grep @sanity",
    "test:crud": "playwright test --grep @crud",
    "test:seed": "playwright test --grep @seed",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "codegen": "playwright codegen",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
