{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@fixtures/*": ["fixtures/*"],
      "@utils/*": ["src/utils/*"],
      "@data/*": ["data/*"],
      "@core/*":["src/core/*"],
      "@menus/*":["src/menus/*"],
      "@tcms/*":["src/tcms/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
